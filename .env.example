BOT_TOKEN=
OWNER_ID=0
# Дополнительные владельцы через запятую. OWNER_ID всегда входит в список.
OWNER_IDS=
MODERATOR_IDS=
COMMUNITY_CHAT_ID=0
# Запасной ключ, если COMMUNITY_CHAT_ID не задан.
GROUP_ID=0
DATABASE_PATH=data/community.db
WELCOME_COVER=assets/bot-avatar.jpg
EVENT_PASS_PRICE=0
SUPPORT_PRICE=0
RESTRICTED_REPUTATION_THRESHOLD=0
TIMEZONE=Europe/Moscow
# Запасной курс, если в админке магазина ещё нет блока печенек. Живой курс: 1 🍪 = 1 ₽.
COOKIE_PRICE_RUB=1
# Числовой ID приватного канала. Бот должен быть администратором канала.
FREEBIE_CHANNEL_ID=0
FREEBIE_CHANNEL_URL=

# Необязательные ответы Норы на свободные обращения.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Private S3 cache of processed avatars/event covers. Leave all empty to use Telegram only.
# Railway: reference nora-media.ENDPOINT/BUCKET/REGION/ACCESS_KEY_ID/SECRET_ACCESS_KEY.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
